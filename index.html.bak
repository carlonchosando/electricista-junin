                        </div>
                    </div>
                    
                    <!-- Servicio 3 -->
                    <div class="group bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100">
                        <div class="relative overflow-hidden h-48">
