                <a href="index.html" class="block py-2 hover:text-secondary transition-colors">Inicio</a>
                <a href="nosotros.html" class="block py-2 hover:text-secondary transition-colors">Nosotros</a>
                <a href="servicios.html" class="block py-2 hover:text-secondary transition-colors">Servicios</a>
                <a href="contacto.html" class="block py-2 hover:text-secondary transition-colors">Contacto</a>
            </div>
        </div>
    </header>

    <main>
