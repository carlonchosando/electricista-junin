                            <div class="absolute inset-0 bg-gradient-to-t from-primary/80 to-transparent opacity-0 group-hover:opacity-70 transition-opacity duration-300"></div>
                            <div class="absolute top-4 right-4 bg-primary/90 text-white font-semibold text-xs py-1 px-2 rounded-full">Alta Tecnología</div>
                        </div>
                        <div class="p-6 relative">
                            <!-- Ícono flotante -->
