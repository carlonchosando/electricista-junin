<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Electricista en Junín - Servicios eléctricos a domicilio, industriales, instalación de cámaras, paneles solares y domótica. Atención 24 horas.">
    <meta name="keywords" content="electricista, electricista a domicilio, electricista Junín, servicio eléctrico, instalación eléctrica, cámaras de seguridad, paneles solares, domótica, automatización">
    <title>Electricista en Junín | Servicios Eléctricos a Domicilio</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#0A4F9F',    // Azul Profundo
                        secondary: '#FFC300',  // Amarillo Dorado
                        accent: '#FF8A65',     // Naranja Coral
                        dark: '#333333',       // Gris Oscuro
                        light: '#F5F5F5',      // Gris Claro
                    },
                    container: {
                        center: true,
                        padding: '1rem',
                        screens: {
                            sm: '640px',
                            md: '768px',
                            lg: '1024px',
                            xl: '1200px',
                        },
                    },
                },
            },
        }
    </script>
    <link rel="stylesheet" href="css/styles.css">
</head>
<body class="font-sans text-dark bg-white">
    <!-- Header y navegación -->
    <header class="bg-primary text-white shadow-md sticky top-0 z-50">
        <div class="container max-w-7xl mx-auto px-4">
            <nav class="flex justify-between items-center py-4">
                <div class="flex items-center">
                    <a href="#" class="text-2xl font-bold">Electricista en Junín</a>
                </div>
                
                <!-- Menú para escritorio -->
                <div class="hidden md:flex space-x-6">
                    <a href="index.html" class="hover:text-secondary transition-colors">Inicio</a>
                    <a href="nosotros.html" class="hover:text-secondary transition-colors">Nosotros</a>
                    <a href="servicios.html" class="hover:text-secondary transition-colors">Servicios</a>
                    <a href="contacto.html" class="hover:text-secondary transition-colors">Contacto</a>
                </div>
                
                <!-- Botón de menú móvil -->
                <button id="menu-toggle" class="md:hidden text-white focus:outline-none">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </nav>
            
            <!-- Menú móvil -->
